# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-a-preview-secret

# PostgreSQL
POSTGRES_HOST_PORT=55432
POSTGRES_DB=dul_ui_gijun
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URI=postgres://postgres:postgres@localhost:55432/dul_ui_gijun

# Cloudflare R2 / S3-compatible storage
R2_BUCKET=dul-ui-gijun-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email / cache (W4)
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
